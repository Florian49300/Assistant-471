<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title><%= typeof titre !== "undefined" ? titre : "Mes outils" %> · Cabinet Durand Godeau</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap">
<style>
  /* Charte du cabinet (reprise de l'espace « Pôle social ») */
  :root{
    --g1:#6ebc5a; --g2:#66a44d; --gd:#345829; --gr:#585b62;
    --wh:#ffffff; --tx:#1e2118; --tm:#585b62; --bd:#d8e8d2; --gl:#edf6ea; --gp:#f3faf1; --page:#e8ece2;
    --dep:#b42318; --rec:#2f6b22; --jaune:#fff8db;
    --f-title:"Sora","Segoe UI",system-ui,sans-serif; --f-body:"DM Sans","Segoe UI",system-ui,sans-serif;
    color-scheme:light;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--page);color:var(--tx);font-family:var(--f-body);font-size:15px;line-height:1.55}
  a{color:var(--gd)}
  h1,h2,h3{font-family:var(--f-title)}

  /* ---------- en-tête des pages d'outil ---------- */
  .entete{background:var(--wh);box-shadow:0 8px 24px -18px rgba(30,40,20,.4)}
  .entete::before{content:"";display:block;height:6px;background:linear-gradient(90deg,var(--gd),var(--g1) 50%,var(--gd))}
  .entete .in{max-width:1180px;margin:auto;padding:12px 20px;display:flex;align-items:center;gap:14px;flex-wrap:wrap}
  .entete .logo img{height:20px;width:auto;display:block}
  .ariane{display:flex;align-items:center;gap:8px;font-family:var(--f-title);font-size:13px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--tm);min-width:0}
  .ariane a{color:var(--g2);text-decoration:none}
  .ariane a:hover{text-decoration:underline}
  .ariane .sep{width:5px;height:5px;border-radius:50%;background:var(--g1)}
  .ariane .ici{color:var(--gd)}
  .entete .sp{flex:1}
  .qui{display:inline-flex;align-items:center;gap:8px;background:var(--tx);color:#fff;padding:6px 14px 6px 12px;border-radius:100px;font-size:13px;max-width:46vw}
  .qui i{width:6px;height:6px;border-radius:50%;background:var(--g1);flex-shrink:0}
  .qui span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .deco{font-size:13px;font-weight:600;color:var(--gd);text-decoration:none}
  .deco:hover{text-decoration:underline}

  /* ---------- contenu des outils ---------- */
  main{max-width:1180px;margin:auto;padding:26px 20px 60px}
  main h1{font-size:24px;margin:0 0 4px;color:var(--tx)}
  .sous{color:var(--tm);margin:0 0 22px}
  .carte{background:var(--wh);border:1px solid var(--bd);border-radius:18px;padding:20px 22px;margin-bottom:18px;box-shadow:0 18px 40px -34px rgba(30,40,20,.35)}
  .carte h2{font-size:16px;margin:0 0 12px;color:var(--gd)}
  input[type=text],input[type=password],input[type=email],input[type=date],input[type=number],textarea{
    font:inherit;padding:9px 12px;border:1px solid var(--bd);border-radius:10px;background:#fff;color:inherit;width:100%}
  input:focus,textarea:focus{outline:2px solid var(--g2);outline-offset:-1px;border-color:transparent}
  input:disabled{background:var(--gp);color:var(--tm)}
  textarea{min-height:300px;font-family:ui-monospace,Consolas,monospace;font-size:13px;line-height:1.45}
  label{display:block;font-size:13px;color:var(--tm);margin-bottom:4px}
  .btn{display:inline-flex;align-items:center;gap:8px;font:inherit;font-weight:600;padding:10px 18px;border-radius:100px;
       border:1px solid var(--gd);background:var(--gd);color:#fff;cursor:pointer;text-decoration:none;transition:background .15s ease}
  .btn:hover{background:#2a4721}
  .btn:focus-visible{outline:2px solid var(--g2);outline-offset:3px}
  .btn.sec{background:#fff;color:var(--gd);border-color:var(--bd)}
  .btn.sec:hover{background:var(--gl);border-color:var(--g2)}
  .grille{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;align-items:end}
  table{width:100%;border-collapse:collapse;font-size:14px}
  th,td{padding:8px 10px;border-bottom:1px solid var(--bd);text-align:left;vertical-align:top}
  th{font-family:var(--f-title);font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--tm);font-weight:600}
  td.m,th.m{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}
  tbody tr:hover td{background:var(--gp)}
  .dep{color:var(--dep)} .rec{color:var(--rec)}
  tfoot td{font-weight:700;border-top:2px solid var(--gd);border-bottom:0}
  .flash{background:#fef3f2;border:1px solid #fecdca;color:#b42318;padding:10px 14px;border-radius:12px;margin-bottom:14px}
  .bandeau-demo{background:var(--jaune);border-bottom:1px solid #f2e3a0;text-align:center;font-size:13px;padding:6px}
  .actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}
  .muted{color:var(--tm);font-size:13px}
  .note{display:flex;gap:10px;align-items:flex-start;padding:14px 18px;border-radius:14px;background:var(--gl);border-left:4px solid var(--g1);color:var(--gr);font-size:13.5px}

  /* ---------- livret (accueil et connexion) ---------- */
  .shell{padding:28px 16px 40px}
  .book{max-width:1180px;margin:0 auto;background:var(--wh);border-radius:26px;box-shadow:0 40px 90px -40px rgba(30,40,20,.35),0 10px 30px -10px rgba(30,40,20,.12);overflow:hidden;position:relative}
  .book::before{content:"";display:block;height:7px;background:linear-gradient(90deg,var(--gd),var(--g1) 50%,var(--gd))}
  .cover{position:relative;overflow:hidden;padding:44px 40px 40px;display:flex;flex-direction:column;align-items:center;min-height:430px}
  .facets{position:absolute;top:0;right:0;width:46%;height:90%;opacity:.5;pointer-events:none;
    background-image:linear-gradient(135deg,rgba(0,0,0,.025) 25%,transparent 25%),linear-gradient(225deg,rgba(0,0,0,.025) 25%,transparent 25%),linear-gradient(45deg,rgba(0,0,0,.02) 25%,transparent 25%),linear-gradient(315deg,rgba(0,0,0,.02) 25%,transparent 25%);
    background-size:46px 46px;-webkit-mask-image:radial-gradient(ellipse 70% 60% at 70% 20%,#000 40%,transparent 78%);mask-image:radial-gradient(ellipse 70% 60% at 70% 20%,#000 40%,transparent 78%)}
  .ribbon{position:absolute;top:0;right:0;height:100%;width:190px;overflow:hidden;pointer-events:none}
  .ribbon svg{position:absolute;top:0;right:-10px;height:100%;width:240px}
  .halfcircle{position:absolute;top:-70px;left:-50px;width:170px;height:170px;border-radius:50%;background:var(--g1);opacity:.13;pointer-events:none}
  .dotgrid{position:absolute;right:210px;bottom:140px;width:112px;height:86px;background-image:radial-gradient(var(--g1) 1.6px,transparent 1.6px);background-size:14px 14px;opacity:.5}
  .dotgrid2{position:absolute;right:24px;top:56px;width:84px;height:64px;background-image:radial-gradient(var(--g1) 1.6px,transparent 1.6px);background-size:12px 12px;opacity:.4}
  .inner{position:relative;z-index:2;width:100%;max-width:720px;display:flex;flex-direction:column;align-items:center;text-align:center}
  .logos{display:flex;flex-direction:column;align-items:center;gap:12px;margin-bottom:28px}
  .logos img{max-width:100%;height:auto}
  .logo-dg{max-height:32px}
  .logo-agora{max-height:28px}
  .tag{display:flex;align-items:center;justify-content:center;gap:14px;font-family:var(--f-title);font-size:11px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--g2);margin-bottom:26px}
  .tag::before,.tag::after{content:"";width:34px;height:1.5px;background:var(--g1)}
  .titlebox{background:var(--tx);border-radius:22px;padding:34px 48px;box-shadow:0 24px 48px -18px rgba(30,33,24,.28);width:100%}
  .titlebox h1{font-size:clamp(24px,3.4vw,36px);font-weight:700;color:#fff;line-height:1.3;letter-spacing:.03em;text-transform:uppercase;margin:0;text-wrap:balance}
  .titlebox h1 .g{color:var(--g1)}
  .hello{display:flex;align-items:center;gap:12px;background:var(--tx);color:rgba(255,255,255,.85);padding:11px 22px 11px 16px;border-radius:100px;font-size:13px;margin-top:22px;text-align:left}
  .hello svg{flex-shrink:0;color:var(--g1)}
  .dotrow{display:flex;justify-content:center;gap:8px;margin-top:14px}
  .dotrow span{width:5px;height:5px;border-radius:50%;background:var(--g1)}
  .cover .badge{position:absolute;left:36px;bottom:30px;display:inline-flex;align-items:center;gap:8px;background:var(--tx);color:#fff;padding:11px 20px;border-radius:100px;font-size:13px;font-weight:600;z-index:2}
  .cover .badge i{width:6px;height:6px;border-radius:50%;background:var(--g1)}
  .logo-cohortis{position:absolute;right:210px;bottom:28px;height:36px;width:auto;z-index:2}
  .coin{position:absolute;top:18px;left:24px;z-index:3;display:flex;align-items:center;gap:12px;font-size:13px}
  .content{padding:8px 48px 48px;border-top:1px solid var(--bd)}
  .sh{display:flex;align-items:center;gap:14px;margin:34px 0 20px}
  .sh .num{font-family:var(--f-title);font-weight:700;font-size:13px;color:#fff;background:var(--gd);border-radius:10px;padding:6px 10px;letter-spacing:.05em}
  .sh h2{font-size:20px;margin:0;color:var(--tx)}
  .sh h2 span{color:var(--g2)}
  .sh::after{content:"";flex:1;height:1.5px;background:linear-gradient(90deg,var(--g1),transparent)}
  .pied{text-align:center;color:var(--tm);font-size:12.5px;padding:18px 16px 0}

  @media (max-width:760px){
    .cover{padding:56px 22px 30px;min-height:auto}
    .ribbon,.facets,.dotgrid,.dotgrid2{display:none}
    .titlebox{padding:24px 22px}
    .cover .badge,.logo-cohortis{position:static;margin-top:18px}
    .cover-foot{display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:center}
    .content{padding:4px 20px 32px}
    .ariane{font-size:12px}
  }
  @media (max-width:600px){ th:nth-child(2),td:nth-child(2){max-width:160px} }
</style>
</head>
<body>
<% if (DEMO) { %><div class="bandeau-demo">Mode démonstration : données fictives (Assistant 471)</div><% } %>
<% if (typeof sansEntete === 'undefined' || !sansEntete) { %>
<header class="entete"><div class="in">
  <a class="logo" href="/" title="Mes outils"><img src="/static/img/logo-dg.jpg" alt="Durand Godeau &amp; Associés"></a>
  <nav class="ariane" aria-label="Fil d'Ariane">
    <span class="sep"></span>
    <% if (module) { %>
      <a href="/">Mes outils</a><span class="sep"></span><a class="ici" href="<%= module.chemin %>"><%= module.titre %></a>
    <% } else { %><a class="ici" href="/">Mes outils</a><% } %>
  </nav>
  <div class="sp"></div>
  <% if (connecte) { %>
    <span class="qui" title="<%= utilisateur.email %>"><i></i><span><%= utilisateur.nom %></span></span>
    <a class="deco" href="/logout">Se déconnecter</a>
  <% } %>
</div></header>
<main>
  <% if (flash) { %><div class="flash"><%= flash %></div><% } %>
<% } %>
