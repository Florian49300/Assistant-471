<%- include('partials/haut', { titre: 'Connexion' }) %>
<div class="carte" style="max-width:380px;margin:40px auto">
  <h1>Connexion</h1>
  <p class="sous">Accès réservé au Cabinet DG.</p>
  <form method="post">
    <label for="pw">Mot de passe</label>
    <input id="pw" type="password" name="password" autocomplete="current-password" autofocus required>
