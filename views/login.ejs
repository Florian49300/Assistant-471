<%- include('partials/haut', { titre: 'Connexion', sansEntete: true }) %>
<%
  const suiteUrl = encodeURIComponent(typeof suite !== 'undefined' ? suite : '/');
  let bloc = '';
  if (flash) bloc += '<div class="flash" style="margin-top:22px;text-align:left;width:100%">' + String(flash).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]) + '</div>';
  if (MICROSOFT) {
    bloc += '<a class="btn btn-ms" href="/auth/microsoft?next=' + suiteUrl + '">'
      + '<svg width="18" height="18" viewBox="0 0 21 21" aria-hidden="true"><rect x="1" y="1" width="9" height="9" fill="#f25022"/><rect x="11" y="1" width="9" height="9" fill="#7fba00"/><rect x="1" y="11" width="9" height="9" fill="#00a4ef"/><rect x="11" y="11" width="9" height="9" fill="#ffb900"/></svg>'
      + 'Se connecter avec Microsoft</a>'
      + '<p class="muted" style="margin:12px 0 0">Avec votre compte du cabinet (adresse @cabinet-dg.fr).</p>';
  } else if (motDePasse) {
    bloc += '<form class="login-pw" method="post" action="/login?next=' + suiteUrl + '">'
      + '<input id="pw" type="password" name="password" placeholder="Mot de passe" aria-label="Mot de passe" autocomplete="current-password" autofocus required>'
      + '<button class="btn" type="submit">Entrer</button></form>'
      + (DEMO ? '<p class="muted" style="margin:10px 0 0">Démo : mot de passe « demo ».</p>' : '');
  } else {
    bloc += '<p style="margin-top:22px">La connexion n’est pas encore configurée sur le serveur.</p>';
  }
%>
<div class="shell">
<div class="book">
  <%- include('partials/couverture', {
    tag: 'Espace de travail — ' + POLE,
    titre: '<span class="g">Mes outils</span> de gestion',
    contenu: '<div class="login-zone">' + bloc + '</div>'
  }) %>
</div>
<footer class="pied">Cabinet Durand Godeau &amp; Associés · Agora Experts · Cohortis Alliance — Accès réservé aux collaborateurs</footer>
</div>
<style>
  .login-zone{width:100%;max-width:420px;margin-top:24px;display:flex;flex-direction:column;align-items:center}
  .btn-ms{width:100%;justify-content:center;background:#fff;color:var(--tx);border:1px solid #8c8c8c;padding:12px 18px}
  .btn-ms:hover{background:#f3f3f3}
  .login-pw{display:flex;gap:10px;width:100%}
  .login-pw input{border-radius:100px;padding:10px 16px}
</style>
<%- include('partials/bas', { sansEntete: true }) %>
