<%- include('../partials/haut', { titre: d.nom + '' }) %>
<% const n = d.operations.length; const lienDossier = base + '/dossier/' + encodeURIComponent(d.companyId); %>
<p class="muted" style="margin:0 0 6px"><a href="<%= base %>">← Tous les dossiers</a></p>
<h1><%= d.nom %></h1>
<p class="sous"><% if (info.code) { %>Code client <%= info.code %> · <% } %>Comptes 4716 / 4717 · opérations non lettrées</p>

<form class="carte" method="get">
  <h2>Période</h2>
  <div class="grille">
    <div><label for="depuis">Du</label><input id="depuis" type="date" name="depuis" value="<%= depuis %>"></div>
    <div><label for="jusqu">Au</label><input id="jusqu" type="date" name="jusqu" value="<%= jusqu %>"></div>
    <div><button class="btn sec" type="submit">Actualiser</button></div>
  </div>
  <p class="muted" style="margin:10px 0 0">Laissez vide pour reprendre toutes les opérations en attente.</p>
</form>

<% if (!n) { %>
<div class="carte"><h2>Rien à demander</h2><p class="muted" style="margin:0">Aucune opération non lettrée sur les comptes 4716 / 4717 pour cette période.</p></div>
<% } else { %>
<% for (const [titre, ops, champ, cls, total] of [['Dépenses à justifier', depenses, 'depense', 'dep', t.depenses], ['Recettes à justifier', recettes, 'recette', 'rec', t.recettes]]) { %>
<div class="carte">
  <h2><%= titre %> · <%= ops.length %> opération<%= ops.length > 1 ? 's' : '' %></h2>
  <% if (!ops.length) { %><p class="muted" style="margin:0">Aucune.</p><% } else { %>
  <table>
    <thead><tr><th>Date</th><th>Libellé bancaire</th><th>Compte</th><th class="m">Montant</th></tr></thead>
    <tbody>
    <% for (const o of ops) { %>
      <tr><td><%= dateFr(o.date) %></td><td><%= o.libelle || '(sans libellé)' %></td><td class="muted"><%= o.compte %></td>
          <td class="m <%= cls %>"><%= euros(o[champ]) %></td></tr>
    <% } %>
    </tbody>
    <tfoot><tr><td></td><td>Total</td><td></td><td class="m <%= cls %>"><%= euros(total) %></td></tr></tfoot>
  </table>
  <% } %>
</div>
<% } %>

<form class="carte" method="post" action="<%= lienDossier %>/eml">
  <input type="hidden" name="csrf" value="<%= csrf %>">
  <input type="hidden" name="depuis" value="<%= depuis %>"><input type="hidden" name="jusqu" value="<%= jusqu %>">
  <h2>Mail au client</h2>
  <div class="grille" style="grid-template-columns:1fr">
    <div><label for="dest">Destinataire (facultatif, modifiable dans Outlook)</label>
      <input id="dest" type="email" name="destinataire" placeholder="client@exemple.fr"></div>
    <div><label>Objet</label><input type="text" value="<%= objet %>" disabled></div>
    <div><label for="avant">Texte avant les tableaux</label>
      <textarea id="avant" name="avant" rows="5" style="min-height:110px"><%= avant %></textarea></div>
    <div><label for="apres">Texte après les tableaux</label>
      <textarea id="apres" name="apres" rows="9" style="min-height:190px"><%= apres %></textarea></div>
    <div><label>Aperçu du mail</label>
      <div class="apercu">
        <div id="ap-avant"></div>
        <%- tableaux %>
        <p style="margin:18px 0 0"></p>
        <div id="ap-apres"></div>
        <% if (signature) { %><div id="ap-sig" data-t="<%= signature %>"></div><% } else { %>
        <p class="muted" style="font-style:italic">[ Votre signature Outlook : Insertion &gt; Signature ]</p><% } %>
      </div></div>
  </div>
  <div class="actions">
    <button class="btn" type="submit">Télécharger le mail (.eml)</button>
    <% if (depenses.length) { %><button class="btn sec" type="submit" formaction="<%= lienDossier %>/excel/depenses">Excel Dépenses</button><% } %>
    <% if (recettes.length) { %><button class="btn sec" type="submit" formaction="<%= lienDossier %>/excel/recettes">Excel Recettes</button><% } %>
  </div>
  <p class="muted" style="margin:12px 0 0">Le .eml contient en pièces jointes l'Excel des dépenses et celui des recettes (tous les sous-comptes 4716 / 4717 regroupés). Ouvrez-le avec Outlook : il s'affiche comme un nouveau message en HTML, prêt à envoyer. Ajoutez votre signature avec Insertion &gt; Signature.</p>
</form>
<% } %>
<style>
  .apercu{border:1px solid var(--bd);border-radius:7px;padding:16px 18px;background:#fff;font-family:Calibri,Arial,sans-serif;font-size:14.5px;overflow-x:auto}
  .apercu table{width:auto}
  .apercu th{text-transform:none;letter-spacing:0;font-size:14.5px}
  .apercu td,.apercu th{font-size:14.5px}
</style>
<script>
  const html = t => t.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]);
  const enP = t => t.trim().split(/\n\s*\n/).filter(p => p.trim()).map(p => '<p style="margin:0 0 12px">' + html(p.trim()).replace(/\n/g, '<br>') + '</p>').join('');
  function maj(){
    for (const k of ['avant','apres']) { const t = document.getElementById(k); if (t) document.getElementById('ap-' + k).innerHTML = enP(t.value); }
    const sig = document.getElementById('ap-sig'); if (sig) sig.innerHTML = enP(sig.dataset.t);
  }
  document.querySelectorAll('#avant,#apres').forEach(t => t.addEventListener('input', maj)); maj();
</script>
<%- include('../partials/bas') %>
