<%- include('partials/haut', { titre: 'Mes outils', sansEntete: true }) %>
<%
  const prenom = utilisateur && utilisateur.email ? String(utilisateur.nom || '').split(' ')[0] : '';
  const fleche = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>';
%>
<div class="shell">
<div class="book">
  <%- include('partials/couverture', {
    tag: 'Espace de travail — ' + POLE,
    titre: '<span class="g">Mes outils</span> de gestion',
    contenu: '<p class="hello"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 21V8l6-4 6 4v13" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M14 21V11l6-3v13" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg><span id="hello" data-prenom="' + (prenom.replace(/[&<>"']/g, '')) + '">Bonjour</span></p>'
  }) %>

  <section class="content">
    <div class="sh"><span class="num">01</span><h2>Accès <span>rapide</span></h2></div>
    <div class="tiles">
    <% for (const m of modules) { const actif = Boolean(m.routeur); %>
      <<%= actif ? 'a' : 'div' %> class="tile<%= actif ? '' : ' bientot' %>"<% if (actif) { %> href="<%= m.chemin %>"<% } else { %> aria-disabled="true"<% } %>>
        <div class="ic" aria-hidden="true"><%- m.icone %></div>
        <h3><%= m.titre %></h3>
        <p><%= m.description %></p>
        <div class="tags"><% for (const t of m.tags) { %><span><%= t %></span><% } %></div>
        <% if (actif) { %>
          <span class="go">Ouvrir <b><%- fleche %></b></span>
        <% } else { %>
          <span class="go soon">Bientôt disponible</span>
        <% } %>
      </<%= actif ? 'a' : 'div' %>>
    <% } %>
    </div>
    <div class="note" style="margin-top:26px">Une seule connexion pour tous les outils. Chaque action est tracée à votre nom.</div>
  </section>
</div>
<footer class="pied">Cabinet Durand Godeau &amp; Associés · Agora Experts · Cohortis Alliance — <%= POLE %></footer>
</div>

<style>
  .tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px}
  .tile{position:relative;display:flex;flex-direction:column;gap:12px;padding:24px 22px 20px;border-radius:18px;background:var(--gp);border:1px solid var(--bd);color:inherit;text-decoration:none;overflow:hidden;transition:transform .15s ease,box-shadow .15s ease,border-color .15s ease;min-width:0}
  .tile::before{content:"";position:absolute;top:0;left:0;right:0;height:4px;background:var(--g1);opacity:0;transition:opacity .15s ease}
  a.tile:hover{transform:translateY(-3px);border-color:var(--g2);box-shadow:0 18px 36px -20px rgba(30,40,20,.35)}
  a.tile:hover::before{opacity:1}
  .tile:focus-visible{outline:2px solid var(--g2);outline-offset:3px}
  .ic{width:54px;height:54px;border-radius:16px;background:var(--tx);color:var(--g1);display:grid;place-items:center}
  .ic svg{width:28px;height:28px}
  .tile h3{font-size:18px;margin:0;color:var(--gd);text-transform:uppercase;letter-spacing:.04em}
  .tile p{margin:0;color:var(--tm);font-size:14.5px}
  .tags{display:flex;flex-wrap:wrap;gap:6px}
  .tags span{font-size:12px;padding:3px 10px;border-radius:999px;background:var(--wh);border:1px solid var(--bd);color:var(--gr)}
  .go{margin-top:auto;padding-top:4px;display:inline-flex;align-items:center;gap:8px;font-weight:600;font-size:14px;color:var(--gd)}
  .go b{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:var(--g1);color:#fff;transition:transform .15s ease}
  .go svg{width:14px;height:14px}
  a.tile:hover .go b{transform:translateX(3px)}
  .tile.bientot{background:#f6f7f4;border-style:dashed}
  .tile.bientot .ic{background:#585b62;color:#d8e8d2}
  .tile.bientot h3{color:var(--gr)}
  .go.soon{font-size:12px;font-family:var(--f-title);letter-spacing:.12em;text-transform:uppercase;color:var(--tm)}
  @media (prefers-reduced-motion:reduce){.tile,.tile::before,.go b{transition:none}a.tile:hover{transform:none}}
</style>
<script>
  (function () {
    var e = document.getElementById('hello'), p = e.dataset.prenom, h = new Date().getHours();
    e.textContent = (h < 18 ? 'Bonjour' : 'Bonsoir') + (p ? ' ' + p : '') + ', quel outil ouvrez-vous aujourd’hui ?';
  })();
</script>
<%- include('partials/bas', { sansEntete: true }) %>
